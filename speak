#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$SCRIPT_DIR/engine/target/release/rtx"

if [[ ! -x "$BIN" ]]; then
  echo "[speak] Building native Rust engine (zero external crates, zero Docker)..." >&2
  (cd "$SCRIPT_DIR/engine" && cargo build --release)
fi

exec "$BIN" speak "$@"
