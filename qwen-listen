#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$SCRIPT_DIR/qwen-nv-rs/target/release/qwen-nv"

if [[ ! -x "$BIN" ]]; then
  echo "[qwen-listen] Building native Rust binary (zero external crates, zero Docker)..."
  (cd "$SCRIPT_DIR/qwen-nv-rs" && cargo build --release)
fi

exec "$BIN" transcribe "$@"
